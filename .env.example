# A future authentication phase will consume Firebase's public web configuration from VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Places API (New) — location search/coordinates only, never prayer times.
# Create separate development/web/Android keys where possible. Restrict each key
# to the Places API and its intended HTTP referrers or Android package/signing cert.
# Never commit a real key. With this blank, the app uses the Ghaziabad development fallback.
VITE_GOOGLE_PLACES_API_KEY=
