rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn() { return request.auth != null; } function admin() { return signedIn() && request.auth.token.admin == true; } match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user' && request.resource.data.accountStatus == 'pending'; allow update: if admin(); } match /adminAudit/{id} { allow read: if admin(); allow write: if false; } } }
